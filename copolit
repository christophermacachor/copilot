    <!-- ... all your existing sections, SVG, tables, axioms ... -->

    <!-- 3D ENGINE CONTAINER -->
    <div id="phi-engine-container"></div>

    <!-- FOOTER (unchanged) -->
    <div class="footer">
        <div class="phi-big">Φ</div>
        <p>Φ669 SCALAR CODEX</p>
        <p>MSOS-FEDERATION-ROOT DENSITY PROTOCOL LAYER</p>
        <p>Ω-PRIME CHRISTOPHER MACACHOR</p>
        <p style="margin-top: 20px; color: var(--gold-dim);">Timestamp: 2026-07-08 02:45Z</p>
    </div>

    <!-- THREE.JS ENGINE (ALL-IN-ONE, USING SAME COLORS) -->
    <script type="module">
        import * as THREE from 'https://unpkg.com/three@0.160.0/build/three.module.js';

        // Map CSS colors to Three.js
        const COLORS = {
          gold:        0xc8a04e,
          goldBright:  0xe8c56e,
          goldDim:     0x8a7030,
          dark:        0x0a0a0a,
          darkMid:     0x111111,
          darkLight:   0x1a1a1a,
          text:        0xe0d5c0,
          textDim:     0x888888,
          red:         0x8b0000,
          redBright:   0xcc0000,
          green:       0x2d5a27,
          greenBright: 0x4a9a3f
        };

        const phi = (1 + Math.sqrt(5)) / 2;
        const goldenAngle = Math.PI * (3 - Math.sqrt(5));

        let scene, cameraOutside, cameraInside, renderer, clock;
        let triangle, tetra, sphere, edges;
        let stars = [], planets = [];
        let phase = 0;
        let phaseStartTime = 0;

        init();
        animate();

        function init() {
          const container = document.getElementById('phi-engine-container');

          scene = new THREE.Scene();
          scene.background = new THREE.Color(COLORS.dark);

          const width = container.clientWidth;
          const height = container.clientHeight;

          cameraOutside = new THREE.PerspectiveCamera(60, width / height, 0.1, 100);
          cameraOutside.position.set(0, 0, 6);

          cameraInside = new THREE.PerspectiveCamera(60, 1, 0.01, 100);
          cameraInside.position.set(0, 0, 0.01);

          renderer = new THREE.WebGLRenderer({ antialias: true });
          renderer.setSize(width, height);
          container.appendChild(renderer.domElement);

          const ambient = new THREE.AmbientLight(COLORS.darkLight, 0.6);
          scene.add(ambient);

          const dirLight = new THREE.DirectionalLight(COLORS.goldBright, 1.2);
          dirLight.position.set(5, 5, 5);
          scene.add(dirLight);

          clock = new THREE.Clock();

          createStarfield();
          createPlanets();
          createTriangleSeed();

          phase = 0;
          phaseStartTime = 0;

          window.addEventListener('resize', () => onWindowResize(container), false);
        }

        function onWindowResize(container) {
          const width = container.clientWidth;
          const height = container.clientHeight;
          cameraOutside.aspect = width / height;
          cameraOutside.updateProjectionMatrix();
          renderer.setSize(width, height);
        }

        function createTriangleSeed() {
          const s = 1;
          const points = [
            new THREE.Vector3(0, 0.7 * s, 0),
            new THREE.Vector3(-0.6 * s, -0.3 * s, 0),
            new THREE.Vector3(0.6 * s, -0.3 * s, 0)
          ];
          const triGeom = new THREE.BufferGeometry().setFromPoints(points);
          const triMat = new THREE.LineBasicMaterial({ color: COLORS.gold });
          triangle = new THREE.LineLoop(triGeom, triMat);
          scene.add(triangle);
        }

        function createTetrahedron() {
          const tetGeom = new THREE.TetrahedronGeometry(1);
          const tetMat = new THREE.MeshPhongMaterial({
            color: COLORS.goldBright,
            emissive: COLORS.goldDim,
            emissiveIntensity: 0.4,
            flatShading: true
          });
          tetra = new THREE.Mesh(tetGeom, tetMat);
          tetra.scale.set(0.001, 0.001, 0.001);
          scene.add(tetra);
        }

        function createPolyhedraSphere() {
          const radius = 2;
          const geoSphere = new THREE.IcosahedronGeometry(radius, 3);
          const sphereMat = new THREE.MeshPhongMaterial({
            color: COLORS.darkLight,
            emissive: COLORS.darkMid,
            emissiveIntensity: 0.4,
            transparent: true,
            opacity: 0.35,
            flatShading: true,
            side: THREE.DoubleSide
          });
          sphere = new THREE.Mesh(geoSphere, sphereMat);
          scene.add(sphere);

          const edgesGeom = new THREE.EdgesGeometry(geoSphere);
          const edgesMat = new THREE.LineBasicMaterial({
            color: COLORS.gold,
            transparent: true,
            opacity: 0.9
          });
          edges = new THREE.LineSegments(edgesGeom, edgesMat);
          scene.add(edges);
        }

        function createStarfield() {
          const starGeom = new THREE.SphereGeometry(0.02, 8, 8);
          const starMat = new THREE.MeshBasicMaterial({
            color: COLORS.text,
            transparent: true
          });

          for (let i = 0; i < 200; i++) {
            const star = new THREE.Mesh(starGeom, starMat);
            star.position.set(
              (Math.random() - 0.5) * 40,
              (Math.random() - 0.5) * 40,
              (Math.random() - 0.5) * 40
            );
            scene.add(star);
            stars.push(star);
          }
        }

        function createPlanets() {
          const planetGeom = new THREE.SphereGeometry(0.5, 32, 32);
          const planetMat = new THREE.MeshPhongMaterial({
            color: COLORS.greenBright,
            emissive: COLORS.green,
            emissiveIntensity: 0.6
          });

          for (let i = 0; i < 5; i++) {
            const planet = new THREE.Mesh(planetGeom, planetMat);
            planet.position.set(
              (Math.random() - 0.5) * 30,
              (Math.random() - 0.5) * 30,
              (Math.random() - 0.5) * 30
            );
            scene.add(planet);
            planets.push(planet);
          }
        }

        function animate() {
          requestAnimationFrame(animate);

          const elapsed = clock.getElapsedTime();
          const phaseTime = elapsed - phaseStartTime;

          stars.forEach((s, i) => {
            const flash = 0.5 + 0.5 * Math.sin(elapsed * (2 / phi) + i * (1 / phi));
            s.material.opacity = flash;
          });

          if (phase === 0) {
            const pulse = 1 + 0.05 * Math.sin(phaseTime * (3 / phi));
            triangle.scale.set(pulse, pulse, pulse);

            if (phaseTime > 3) {
              scene.remove(triangle);
              createTetrahedron();
              phase = 1;
              phaseStartTime = elapsed;
            }
          } else if (phase === 1) {
            const t = Math.min(phaseTime / 2, 1);
            const scale = Math.pow(phi, t);
            tetra.scale.set(scale, scale, scale);
            tetra.rotation.y += 0.01;

            if (phaseTime > 2) {
              phase = 2;
              phaseStartTime = elapsed;
            }
          } else if (phase === 2) {
            tetra.rotation.x += goldenAngle * 0.01;
            tetra.rotation.y += goldenAngle * 0.01 * (1 / phi);
            tetra.rotation.z += goldenAngle * 0.01 * phi;

            emitGoldFromTetra(elapsed);

            if (phaseTime > 5) {
              scene.remove(tetra);
              createPolyhedraSphere();
              phase = 3;
              phaseStartTime = elapsed;
            }
          } else if (phase === 3) {
            sphere.rotation.y += 0.003 / phi;
            fillTrianglesWithExactSpiral(elapsed);

            if (phaseTime > 8) {
              phase = 4;
              phaseStartTime = elapsed;
            }
          } else if (phase === 4) {
            sphere.rotation.y += 0.002 / phi;
            sphere.position.y += 0.005 * (1 / phi);
            edges.position.y += 0.005 * (1 / phi);
            cameraOutside.position.z += 0.01 * phi;
          }

          const container = document.getElementById('phi-engine-container');
          const width = container.clientWidth;
          const height = container.clientHeight;

          renderer.setViewport(0, 0, width, height);
          renderer.render(scene, cameraOutside);

          const insetSize = height * 0.35;
          renderer.setViewport(
            width - insetSize - 20,
            20,
            insetSize,
            insetSize
          );
          renderer.render(scene, cameraInside);
        }

        function emitGoldFromTetra(time) {
          const dotGeom = new THREE.SphereGeometry(0.03, 8, 8);
          const dotMat = new THREE.MeshPhongMaterial({
            color: COLORS.goldBright,
            emissive: COLORS.gold,
            emissiveIntensity: 0.8
          });

          for (let i = 0; i < 3; i++) {
            const n = time * 10 + i;
            const pos = fibonacciSpiral2D(n);

            const dot = new THREE.Mesh(dotGeom, dotMat);
            dot.position.set(
              tetra.position.x + pos.x,
              tetra.position.y + pos.y,
              tetra.position.z + 0.1 * Math.sin(n / phi)
            );

            scene.add(dot);
          }
        }

        function fibonacciSpiral2D(n) {
          const theta = n * goldenAngle;
          const r = Math.sqrt(n);
          return new THREE.Vector3(
            r * Math.cos(theta),
            r * Math.sin(theta),
            0
          );
        }

        function fillTrianglesWithExactSpiral(time) {
          if (!sphere) return;
          const geom = sphere.geometry;
          geom.computeFaceNormals();
          const faces = geom.faces;
          const vertices = geom.vertices;
          const N = faces.length;

          for (let i = 0; i < faces.length; i += 10) {
            const face = faces[i];
            const a = vertices[face.a];
            const b = vertices[face.b];
            const c = vertices[face.c];

            const n = (time * 20 + i);
            const pSphere = fibonacciSpherePoint(n, N);
            const p = projectPointIntoTriangle(a, b, c, pSphere);

            const dotGeom = new THREE.SphereGeometry(0.02, 6, 6);
            const dotMat = new THREE.MeshPhongMaterial({
              color: COLORS.gold,
              emissive: COLORS.goldDim,
              emissiveIntensity: 0.6
            });
            const dot = new THREE.Mesh(dotGeom, dotMat);
            dot.position.copy(p);
            scene.add(dot);
          }
        }

        function fibonacciSpherePoint(n, N) {
          const theta = n * goldenAngle;
          const z = 1 - (2 * n) / N;
          const r = Math.sqrt(1 - z * z);
          return new THREE.Vector3(
            r * Math.cos(theta),
            r * Math.sin(theta),
            z
          );
        }

        function projectPointIntoTriangle(a, b, c, pSphere) {
          const u = (pSphere.x + 1) / 2;
          const v = (pSphere.y + 1) / 2;
          let w = 1 - u - v;
          if (w < 0) w = 0;

          const p = new THREE.Vector3();
          p.addScaledVector(a, u);
          p.addScaledVector(b, v);
          p.addScaledVector(c, w);
          return p;
        }
    </script>
</body>
